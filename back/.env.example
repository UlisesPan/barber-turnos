# Base de datos PostgreSQL
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# Servidor
PORT=3000
NODE_ENV=development

# Poné DB_SYNC=true SOLO en el primer deploy para que se creen las tablas.
# Luego borralo/ponelo en false para no arriesgar el schema en producción.
DB_SYNC=false

# JWT — generá un secreto fuerte: openssl rand -base64 48
JWT_SECRET=

# Nodemailer (Gmail App Password recomendado)
EMAIL_USER=
EMAIL_PASS=
OWNER_EMAIL=

# Frontend (URL de tu app desplegada o http://localhost:5173 en dev)
FRONT_URL=http://localhost:5173
